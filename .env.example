# Copy this file to .env and replace every placeholder.
# Use a domain pointed to your VPS public IP.
DOMAIN=android.example.com
LOGIN_USER=raphael
# Generate a bcrypt hash on the VPS; do not put your plain password here:
# docker run --rm caddy:2 caddy hash-password --plaintext 'CHOOSE_A_NEW_STRONG_PASSWORD'
LOGIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
